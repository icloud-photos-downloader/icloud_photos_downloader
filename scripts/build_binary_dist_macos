#!/usr/bin/env bash
set -euo pipefail

# prepare binary wheels in dist
# expects dist to have comipled binary versions
# required params: version arch (amd64 or arm64)

# clean start
rm -rf dist/binary_dist

# basic
cp -r binary_dist dist/binary_dist
cp LICENSE.md dist/binary_dist/
cp README_PYPI.md dist/binary_dist/

cp dist/icloudpd-$1-macos-$2 dist/binary_dist/src/icloudpd/icloudpd
cp dist/icloud-$1-macos-$2 dist/binary_dist/src/icloud/icloud
python3 -m pip wheel dist/binary_dist/ -w dist/binary_dist --no-deps --no-build-isolation

# the wheel only contains the binary for one architecture, so tag it for that one
case "$2" in
    amd64) plat=macosx_13_0_x86_64 ;;
    arm64) plat=macosx_13_0_arm64 ;;
    *) echo "unknown arch: $2" >&2; exit 2 ;;
esac
mv -f dist/binary_dist/icloudpd-$1-py2.py3-none-any.whl dist/icloudpd-$1-py2.py3-none-$plat.whl
